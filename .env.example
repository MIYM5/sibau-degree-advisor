# Research collection is fail-closed. These are server-side administrative
# configuration values; do not prefix them with NEXT_PUBLIC_. Configuration does
# not itself prove legal or ethics approval. Keep real secrets out of this file.
RESEARCH_DATA_COLLECTION_ENABLED=false
RESEARCH_ETHICS_APPROVAL_REFERENCE=
RESEARCH_ETHICS_COMMITTEE_NAME=
RESEARCH_RESPONSIBLE_RESEARCHER=
RESEARCH_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
RESEARCH_RETENTION_YEARS=
RESEARCH_WITHDRAWAL_URL=
MINOR_RESEARCH_PROCESS_APPROVED=false

# Required in addition to the adult fields before the administrative status can
# report minor research readiness. These references are not displayed publicly.
RESEARCH_GUARDIAN_CONSENT_PROCEDURE_REFERENCE=
RESEARCH_MINOR_ASSENT_PROCEDURE_REFERENCE=

# Supabase infrastructure is server-write-only and is not connected to the UI.
# Credentials never enable collection without valid research governance,
# participant eligibility, consent, and payload validation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret: server environment only. Never expose, log, or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Local synthetic API integration test only. This flag is false by default and
# is never an application/API governance bypass. The test also refuses any app
# or Supabase URL whose hostname is not exactly localhost or 127.0.0.1.
LOCAL_SYNTHETIC_RESEARCH_TEST_ENABLED=false
LOCAL_RESEARCH_TEST_APP_URL=
